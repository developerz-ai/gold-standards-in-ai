#!/usr/bin/env bash
# Regression fixtures for the Markdown validator; no downloaded dependencies.
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
validator="$repo_root/bin/check-docs"
gate="$repo_root/bin/check"
precondition_output='check-docs: docs directory missing - gate refused to grade'
# Depth of nested suites. bin/check runs bin/test, so a full bin/check from
# inside this suite would recurse into it; the marker bounds the nesting.
gate_depth=${GATE_TEST_DEPTH:-0}
fixtures=$(mktemp -d "${TMPDIR:-/tmp}/check-docs.XXXXXXXX")
trap 'rm -rf -- "$fixtures"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

passed=0
failed=0
fixture_number=0

new_fixture() {
    fixture_number=$((fixture_number + 1))
    root="$fixtures/$fixture_number"
    mkdir -p "$root/docs"
    printf '# Fixture\n' > "$root/README.md"
}

# Compares one run's status and output with what the contract requires.
assert_result() {
    local name=$1 expected_status=$2 expected_output=$3 status=$4 output=$5
    if [[ $status -eq $expected_status && $output == "$expected_output" ]]; then
        printf 'PASS %s\n' "$name"
        passed=$((passed + 1))
    else
        printf 'FAIL %s\n' "$name"
        printf '  expected status: %s; actual: %s\n' "$expected_status" "$status"
        printf '  expected output: %q\n  actual output: %q\n' "$expected_output" "$output"
        failed=$((failed + 1))
    fi
}

assert_validation() {
    local name=$1 expected_status=$2 expected_output=$3
    local output status
    if output=$(bash "$validator" "$root" 2>&1); then
        status=0
    else
        status=$?
    fi
    last_status=$status
    assert_result "$name" "$expected_status" "$expected_output" "$status" "$output"
}

# Drives the public entrypoint, so the status must survive the whole chain.
# --docs-only: bin/check runs bin/test, and a full bin/check from inside a
# fixture would recurse into this suite.
assert_gate() {
    local name=$1 expected_status=$2 expected_output=$3
    local output status
    if output=$(bash "$gate" --docs-only "$root" 2>&1); then
        status=0
    else
        status=$?
    fi
    last_status=$status
    assert_result "$name" "$expected_status" "$expected_output" "$status" "$output"
}

# The full public path: bin/check grades the tree, then runs the regression
# suite. That suite runs this file again, so the depth marker keeps the
# nesting at one level and the inner run skips the full-gate fixtures.
assert_gate_full() {
    local name=$1 expected_status=$2 expected_output=$3
    local output status
    if output=$(GATE_TEST_DEPTH=$((gate_depth + 1)) bash "$gate" "$root" 2>&1); then
        status=0
    else
        status=$?
    fi
    last_status=$status
    assert_result "$name" "$expected_status" "$expected_output" "$status" "$output"
}

# A precondition status and a validation status must never collide.
assert_distinct() {
    local name=$1 first=$2 second=$3
    if [[ $first -ne 0 && $second -ne 0 && $first -ne $second ]]; then
        printf 'PASS %s\n' "$name"
        passed=$((passed + 1))
    else
        printf 'FAIL %s\n' "$name"
        printf '  statuses must be distinct and non-zero: %s and %s\n' "$first" "$second"
        failed=$((failed + 1))
    fi
}

new_fixture
printf '[Topic](docs/topic.md)\n' >> "$root/README.md"
printf 'topic.md\n' > "$root/docs/README.md"
printf '[Home](../README.md)\n' > "$root/docs/topic.md"
assert_validation 'valid indexed docs and relative links' 0 ''

new_fixture
rmdir "$root/docs"
assert_validation 'missing docs directory' 75 "$precondition_output"
precondition_status=$last_status

new_fixture
printf '# Unindexed\n' > "$root/docs/topic.md"
assert_validation 'unindexed document diagnostic' 1 './docs/topic.md'
validation_status=$last_status

assert_distinct 'precondition status differs from validation status' \
    "$precondition_status" "$validation_status"

new_fixture
rmdir "$root/docs"
assert_gate 'gate refuses to grade a missing docs tree' 75 "$precondition_output"
gate_precondition_status=$last_status

new_fixture
printf '[Topic](docs/topic.md)\n' >> "$root/README.md"
printf 'topic.md\n' > "$root/docs/README.md"
printf '[Home](../README.md)\n' > "$root/docs/topic.md"
assert_gate 'gate accepts a valid tree' 0 ''

assert_distinct 'gate precondition status differs from validation status' \
    "$gate_precondition_status" "$validation_status"

# The full public path - bin/check grades the tree and then runs the
# regression suite - at the outermost level only; a nested suite would
# recurse into itself.
if [[ $gate_depth -eq 0 ]]; then
    new_fixture
    rmdir "$root/docs"
    assert_gate_full 'full gate refuses to grade a missing docs tree' 75 \
        "$precondition_output"
    full_gate_precondition_status=$last_status

    new_fixture
    printf '# Unindexed\n' > "$root/docs/topic.md"
    assert_gate_full 'full gate reports an unindexed document' 1 './docs/topic.md'
    full_gate_validation_status=$last_status

    new_fixture
    printf '[Missing](missing.md)\n' >> "$root/README.md"
    assert_gate_full 'full gate reports a broken relative link' 1 \
        './README.md missing.md'

    new_fixture
    printf '[Topic](docs/topic.md)\n' >> "$root/README.md"
    printf 'topic.md\n' > "$root/docs/README.md"
    printf '[Home](../README.md)\n' > "$root/docs/topic.md"
    assert_gate_full 'full gate accepts a valid tree and runs the suite' 0 ''

    assert_distinct 'full gate precondition status differs from validation status' \
        "$full_gate_precondition_status" "$full_gate_validation_status"
fi

new_fixture
mkdir -p "$root/docs/section"
printf 'topic.md\n' > "$root/docs/section/README.md"
printf '# Topic\n' > "$root/docs/section/topic.md"
printf '[Topic](docs/section/topic.md)\n' >> "$root/README.md"
assert_validation 'section index accepts basename' 0 ''

new_fixture
printf '# Section index\n' > "$root/docs/README.md"
assert_validation 'README needs no index entry' 0 ''

new_fixture
printf '[Missing](missing.md)\n' >> "$root/README.md"
assert_validation 'broken relative link diagnostic' 1 './README.md missing.md'

new_fixture
printf '[Missing](missing.md#heading)\n' >> "$root/README.md"
assert_validation 'broken link with fragment' 1 './README.md missing.md'

new_fixture
cat >> "$root/README.md" <<'MARKDOWN'
[Web](https://example.invalid/missing)
[HTTP](http://example.invalid/missing)
[Mail](mailto:nobody@example.invalid)
[Custom](custom:missing)
[Heading](#fixture)
MARKDOWN
assert_validation 'URLs and fragment-only links ignored' 0 ''

new_fixture
cat >> "$root/README.md" <<'MARKDOWN'
Inline `[Missing](inline-missing.md)` example.
```markdown
[Missing](fenced-missing.md)
```
   ```markdown
[Missing](indented-fenced-missing.md)
   ```
MARKDOWN
assert_validation 'inline and fenced code examples ignored' 0 ''

new_fixture
cat >> "$root/README.md" <<'MARKDOWN'
```
[Missing](example.md)
```
[Missing](real-missing.md)
MARKDOWN
assert_validation 'links after code fences still validated' 1 './README.md real-missing.md'

new_fixture
printf '[Home](README.md#fixture)\n' >> "$root/README.md"
assert_validation 'existing link with fragment' 0 ''

new_fixture
mkdir -p "$root/docs/section"
printf '# Topic\n' > "$root/docs/section/topic.md"
printf 'topic.md\n' > "$root/docs/section/README.md"
assert_validation 'doc in section index only is reported' 1 './docs/section/topic.md'

new_fixture
mkdir -p "$root/docs/section"
printf '# Topic\n' > "$root/docs/section/topic.md"
printf '[Topic](docs/section/topic.md)\n' >> "$root/README.md"
assert_validation 'doc in root index only is reported' 1 './docs/section/topic.md'

new_fixture
mkdir -p "$root/docs/section"
printf '# Topic\n' > "$root/docs/section/topic.md"
printf 'topic.md\n' > "$root/docs/section/README.md"
printf '[Topic](docs/section/topic.md)\n' >> "$root/README.md"
assert_validation 'doc in both indexes passes' 0 ''

new_fixture
printf '# Target\n\n## Real heading\n' > "$root/docs/target.md"
printf '[Home](../README.md)\n' >> "$root/docs/target.md"
printf 'target.md\n' > "$root/docs/README.md"
printf '[Target](docs/target.md#missing-heading)\n' >> "$root/README.md"
assert_validation 'dead anchor reported' 1 './README.md docs/target.md#missing-heading dead anchor'

new_fixture
printf '[Self](#missing-heading)\n' >> "$root/README.md"
assert_validation 'dead anchor in the current file reported' 1 './README.md #missing-heading dead anchor'

new_fixture
mkdir -p "$root/docs/section"
printf '# Target\n\n## Real heading\n' > "$root/docs/section/target.md"
printf 'target.md\n' > "$root/docs/section/README.md"
printf '[Target](docs/section/target.md#real-heading)\n' >> "$root/README.md"
assert_validation 'valid cross-file fragment passes' 0 ''

new_fixture
mkdir -p "$root/docs/section"
printf '# Target\n\n## Real heading\n' > "$root/docs/section/target.md"
printf 'target.md\n' > "$root/docs/section/README.md"
cat >> "$root/README.md" <<'MARKDOWN'
```markdown
[Dead](docs/section/target.md#missing-heading)
```
MARKDOWN
assert_validation 'fragment inside a fenced example ignored' 0 ''

new_fixture
mkdir -p "$root/docs/section"
printf '# Target\n\n## Real heading\n' > "$root/docs/section/target.md"
printf 'target.md\n' > "$root/docs/section/README.md"
cat >> "$root/README.md" <<'MARKDOWN'
Inline `[Dead](docs/section/target.md#missing-heading)` example.
MARKDOWN
assert_validation 'fragment inside an inline example ignored' 0 ''

# A heading slug drops punctuation, symbols and emoji: only letters, digits,
# '-', '_' and spaces survive, and a space becomes '-'. Both the emoji heading
# and the em-dash heading below slug to a name the link must match.
new_fixture
mkdir -p "$root/docs/section"
cat > "$root/docs/section/target.md" <<'MARKDOWN'
# Target

## ⌨️ Keyboard paths

## Docs decay — write for the next session

## Archetypes & rotation
MARKDOWN
printf 'target.md\n' > "$root/docs/section/README.md"
cat >> "$root/README.md" <<'MARKDOWN'
[Keyboard](docs/section/target.md#-keyboard-paths)
[Decay](docs/section/target.md#docs-decay--write-for-the-next-session)
[Archetypes](docs/section/target.md#archetypes--rotation)
MARKDOWN
assert_validation 'punctuation and emoji dropped from heading slugs' 0 ''

# The same slugs, minus the deletion of punctuation and emoji, are dead
# anchors - the slug is not the raw heading text.
new_fixture
mkdir -p "$root/docs/section"
cat > "$root/docs/section/target.md" <<'MARKDOWN'
# Target

## ⌨️ Keyboard paths

## Docs decay — write for the next session
MARKDOWN
printf 'target.md\n' > "$root/docs/section/README.md"
cat >> "$root/README.md" <<'MARKDOWN'
[Keyboard](docs/section/target.md#keyboard-paths)
[Decay](docs/section/target.md#docs-decay-write-for-the-next-session)
MARKDOWN
assert_validation 'slug is not the raw heading text' 1 './README.md docs/section/target.md#keyboard-paths dead anchor
./README.md docs/section/target.md#docs-decay-write-for-the-next-session dead anchor'

# An explicit HTML anchor is an anchor in its own right, beside the heading
# slug it sits on.
new_fixture
mkdir -p "$root/docs/section"
cat > "$root/docs/section/target.md" <<'MARKDOWN'
# Target

## <a name="docs-decay"></a>Docs decay — write for the next session
MARKDOWN
printf 'target.md\n' > "$root/docs/section/README.md"
cat >> "$root/README.md" <<'MARKDOWN'
[Decay](docs/section/target.md#docs-decay)
MARKDOWN
assert_validation 'explicit HTML anchor resolves' 0 ''

# Without the explicit HTML anchor the same fragment is dead: the HTML anchor
# branch is what makes the link above resolve.
new_fixture
mkdir -p "$root/docs/section"
cat > "$root/docs/section/target.md" <<'MARKDOWN'
# Target

## Docs decay — write for the next session
MARKDOWN
printf 'target.md\n' > "$root/docs/section/README.md"
cat >> "$root/README.md" <<'MARKDOWN'
[Decay](docs/section/target.md#docs-decay)
MARKDOWN
assert_validation 'fragment without the HTML anchor is dead' 1 './README.md docs/section/target.md#docs-decay dead anchor'

# Two identical headings: GitHub exposes the first as the bare slug and the
# second as '<slug>-1' - the checker must offer both, not the bare slug twice.
new_fixture
mkdir -p "$root/docs/section"
cat > "$root/docs/section/target.md" <<'MARKDOWN'
# Target

## Topic

## Topic
MARKDOWN
printf 'target.md\n' > "$root/docs/section/README.md"
cat >> "$root/README.md" <<'MARKDOWN'
[First](docs/section/target.md#topic)
[Second](docs/section/target.md#topic-1)
MARKDOWN
assert_validation 'duplicate headings get GitHub collision suffixes' 0 ''

# A suffix beyond the collision count still matches no heading.
new_fixture
mkdir -p "$root/docs/section"
cat > "$root/docs/section/target.md" <<'MARKDOWN'
# Target

## Topic

## Topic
MARKDOWN
printf 'target.md\n' > "$root/docs/section/README.md"
printf '[Third](docs/section/target.md#topic-2)\n' >> "$root/README.md"
assert_validation 'suffix beyond the collision count is dead' 1 './README.md docs/section/target.md#topic-2 dead anchor'

# A heading that already carries a suffix is taken: 'Topic', 'Topic-1', then
# 'Topic' must yield topic, topic-1, topic-2 - the third heading advances its
# suffix past the existing suffixed heading, as GitHub does.
new_fixture
mkdir -p "$root/docs/section"
cat > "$root/docs/section/target.md" <<'MARKDOWN'
# Target

## Topic

## Topic-1

## Topic
MARKDOWN
printf 'target.md\n' > "$root/docs/section/README.md"
cat >> "$root/README.md" <<'MARKDOWN'
[First](docs/section/target.md#topic)
[Second](docs/section/target.md#topic-1)
[Third](docs/section/target.md#topic-2)
MARKDOWN
assert_validation 'duplicate heading advances past an existing suffixed heading' 0 ''

# Advancing stops at the first free name: 'topic-3' matches no heading here.
new_fixture
mkdir -p "$root/docs/section"
cat > "$root/docs/section/target.md" <<'MARKDOWN'
# Target

## Topic

## Topic-1

## Topic
MARKDOWN
printf 'target.md\n' > "$root/docs/section/README.md"
printf '[Fourth](docs/section/target.md#topic-3)\n' >> "$root/README.md"
assert_validation 'suffix past the advanced collision is dead' 1 './README.md docs/section/target.md#topic-3 dead anchor'

# A link may carry a title - validate the target and fragment, never the
# quoted title.
new_fixture
printf '[Home](README.md#fixture "Home")\n' >> "$root/README.md"
assert_validation 'link title is stripped before validation' 0 ''

printf '%s passed; %s failed\n' "$passed" "$failed"
[[ $failed -eq 0 ]]
