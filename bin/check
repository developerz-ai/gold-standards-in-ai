#!/usr/bin/env bash
# One gate: Markdown validation, tracked script modes and their regression
# tests. Silent on success.
#
# Usage: bin/check [--docs-only] [root]
#   root         tree to grade (default: the repo root)
#   --docs-only  grade the tree with the validator only, skip the test suite
#
# Exit codes:
#   0                    the change passes
#   75                   a precondition the gate needs is unmet - it refused to grade
#   any other non-zero   the gate ran and the change is red
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)

run_tests=1
root=$repo_root
trees=0
for arg in "$@"; do
    case $arg in
        --docs-only)
            run_tests=0
            ;;
        -*)
            printf 'check: unknown option: %s\n' "$arg" >&2
            exit 2
            ;;
        *)
            trees=$((trees + 1))
            if [[ $trees -gt 1 ]]; then
                printf 'check: one tree at a time\n' >&2
                exit 2
            fi
            root=$arg
            ;;
    esac
done

if [[ ! -d $root ]]; then
    printf 'check: no such tree: %s\n' "$root" >&2
    exit 75
fi
root=$(cd "$root" && pwd)

# A tracked script under bin/ keeps its executable bit: in the index and on
# disk. A lost bit turns 'bin/check' into 'Permission denied' before the gate
# can say anything, so the gate grades it instead. A tree that is not a git
# repository tracks nothing - there is nothing to grade and the check skips
# silently. The check never refuses to grade, so it never exits 75.
mode_findings=0
check_tracked_modes() {
    local tree=$1
    local listing mode _object _stage path first_line
    if ! listing=$(git -C "$tree" ls-files --stage -- bin/ 2>/dev/null); then
        return 0
    fi
    while read -r mode _object _stage path; do
        if [[ -z $path ]]; then
            continue
        fi
        # A symlink carries no script of its own.
        if [[ $mode == 120000 ]]; then
            continue
        fi
        if [[ ! -f "$tree/$path" ]]; then
            continue
        fi
        first_line=''
        IFS= read -r first_line 2>/dev/null < "$tree/$path" || true
        if [[ $first_line != '#!'* ]]; then
            continue
        fi
        if [[ $mode != 100755 ]]; then
            printf '%s not executable (tracked %s)\n' "$path" "$mode"
            mode_findings=1
        elif [[ ! -x "$tree/$path" ]]; then
            printf '%s not executable (working tree)\n' "$path"
            mode_findings=1
        fi
    done <<< "$listing"
}

# The mode check grades the tree the gate was given, before the validator.
# It runs in the full path only: --docs-only grades the Markdown tree alone.
if [[ $run_tests -eq 1 ]]; then
    check_tracked_modes "$root"
    if [[ $mode_findings -ne 0 ]]; then
        exit 1
    fi
fi

# The validator's status passes through unchanged: 75 (refused to grade), 1 (a
# validation diagnostic) or 0. Never collapse 75 into another code.
validator_status=0
bash "$repo_root/bin/check-docs" "$root" || validator_status=$?
if [[ $validator_status -ne 0 ]]; then
    exit "$validator_status"
fi

if [[ $run_tests -eq 0 ]]; then
    exit 0
fi

# A regression failure keeps its own status.
if test_output=$(bash "$repo_root/bin/test" 2>&1); then
    :
else
    status=$?
    printf '%s\n' "$test_output"
    exit "$status"
fi
