#!/usr/bin/env bash
# Validate Markdown indexing and relative links, optionally in a fixture root.
#
# Exit codes:
#   0   the tree is valid
#   75  a precondition this validator needs is unmet - it refused to grade
#   1   the tree ran and is invalid (unindexed doc, broken relative link)
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
root=${1:-$repo_root}

if [[ ! -d $root ]]; then
    printf 'check-docs: no such tree: %s\n' "$root" >&2
    exit 75
fi
cd "$root"

# The docs tree is what gets graded. Missing = the gate could not run, never a
# red change, so this exits 75 and not 1.
if [[ ! -d docs ]]; then
    printf 'check-docs: docs directory missing - gate refused to grade\n' >&2
    exit 75
fi

# Keep the original parser: omit triple-backtick fences and inline code;
# ignore fragments and targets containing a colon. Index by literal basename.
diagnostics=$(
    set +e
    find . -name '*.md' | while read -r file; do
        directory=${file%/*}
        basename=${file##*/}
        case $file in
            ./docs/*)
                [[ $basename == README.md ]] ||
                    grep -qsF "$basename" README.md "$directory/README.md" ||
                    echo "$file"
                ;;
        esac

        sed '/^ *```/,/^ *```/d;s/`[^`]*`//g' "$file" |
            grep -oE '\]\([^)#[:space:]]+' |
            cut -c3- |
            grep -v ':' |
            while read -r link; do
                [[ -e "$directory/$link" ]] || echo "$file $link"
            done
    done
    true
)

if [[ -n $diagnostics ]]; then
    echo "$diagnostics"
    exit 1
fi
