# .env.example — established by dz-runner setup mode.
# NAMES only. Copy to `.env`, fill each value there, and never commit that file.

# dormant: delivered in the agent env by the platform; no setup, dev or check command in this repo reads it (optional)
SENTRY_ACCESS_TOKEN=

# dormant: delivered in the agent env by the platform; no setup, dev or check command in this repo reads it (optional)
SENTRY_HOST=

# required: Bearer credential for the `developerz` MCP server in `.mcp.json`; the value is read from the environment, never committed
DEVELOPERZ_API_KEY=
